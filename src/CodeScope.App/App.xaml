<Application x:Class="CodeScope.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CodeScope.Converters"
             ShutdownMode="OnMainWindowClose"
             StartupUri="MainWindow.xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The theme dictionary is swapped at runtime by ThemeManager. -->
        <ResourceDictionary Source="Resources/Themes/Dark.xaml" />
        <ResourceDictionary Source="Resources/Styles/Icons.xaml" />
        <ResourceDictionary Source="Resources/Styles/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
      <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
      <converters:IntGreaterThanZeroConverter x:Key="IntGreaterThanZero" />
      <converters:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
      <converters:SeriesIndexToBrushConverter x:Key="SeriesIndexToBrush" />
      <converters:StringListConverter x:Key="StringList" />

      <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="FontSize" Value="12.5" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
