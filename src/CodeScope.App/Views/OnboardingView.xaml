<UserControl x:Class="CodeScope.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CodeScope.ViewModels"
             xmlns:controls="clr-namespace:CodeScope.Controls"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <Grid>
    <Border Background="{DynamicResource ScrimBrush}" />

    <Border x:Name="Card"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusXl}"
            Padding="0"
            MaxWidth="760"
            Margin="32"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
      <Border.Effect>
        <DropShadowEffect BlurRadius="42" ShadowDepth="14" Opacity="0.45" Color="#000000" />
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Border Grid.Row="0" Padding="34,28,34,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="{StaticResource RadiusLg}"
                    Background="{DynamicResource AccentSubtleBrush}"
                    Margin="0,0,16,0">
              <controls:IconView Geometry="{StaticResource IconBolt}" Fill="{DynamicResource AccentBrush}"
                                Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding OnboardingTitle}" Style="{StaticResource TitleStyle}" />
              <TextBlock Text="{Binding OnboardingProgressText}" Style="{StaticResource MicroLabelStyle}"
                         Margin="0,4,0,0" />
            </StackPanel>

            <!-- step dots -->
            <ItemsControl Grid.Column="2" VerticalAlignment="Center" Width="92" Height="20"
                          ItemsSource="{Binding OnboardingStepDots}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Width="14" Height="14" Margin="2,0,0,0">
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource BorderStrongBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                              <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                          <Setter Property="Opacity" Value="0" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- ============ body ============ -->
        <Grid Grid.Row="1" Margin="34,18,34,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{Binding OnboardingSubtitle}"
                     Style="{StaticResource SectionSubtitleStyle}" FontSize="13.5" />

          <ItemsControl Grid.Row="1" ItemsSource="{Binding OnboardingBullets}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="6" Height="6" Margin="3,7,0,0"
                           Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource CaptionStyle}"
                             FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- step specific content -->
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <!-- step 2: pick the folder -->
            <StackPanel Visibility="{Binding IsOnboardingFolderStep, Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource CardStyle}" Padding="16" Background="{DynamicResource SurfaceAltBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Style="{StaticResource InputStyle}" MinHeight="40"
                           Text="{Binding ProjectPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="The folder to analyse" />
                  <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                          Content="Browse…" Command="{Binding BrowseCommand}" />
                </Grid>
              </Border>
              <TextBlock Style="{StaticResource EmptyStateStyle}" Margin="2,8,0,0"
                         Text="You can skip this and pick a folder later." />
            </StackPanel>

            <!-- step 3: choose what to include -->
            <StackPanel Visibility="{Binding IsOnboardingContentStep, Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource CardStyle}" Padding="16" Background="{DynamicResource SurfaceAltBrush}">
                <StackPanel>
                  <TextBlock Text="Start from a preset" Style="{StaticResource LabelStyle}" />
                  <ItemsControl ItemsSource="{Binding Presets}" Margin="0,2,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"
                                Content="{Binding}" Command="{Binding DataContext.ApplyPresetCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource EmptyStateStyle}" Margin="0,6,0,0"
                             Text="Presets bundle the report sections, the analysis options and the output mode." />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- step 4: summary -->
            <StackPanel Visibility="{Binding IsOnboardingSummaryStep, Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource CardStyle}" Padding="16" Background="{DynamicResource SurfaceAltBrush}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folder" Style="{StaticResource LabelStyle}" Margin="0" />
                    <TextBlock Grid.Column="1" Text="{Binding ProjectPath}" Style="{StaticResource CaptionStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preset" Style="{StaticResource LabelStyle}" Margin="0" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedPreset}" Style="{StaticResource CaptionStyle}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ============ footer ============ -->
        <Border Grid.Row="2" Padding="34,20,34,26" Margin="0,20,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource GhostButtonStyle}" Content="Skip"
                    Command="{Binding OnboardingSkipCommand}" />

            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Back"
                    Margin="0,0,10,0" Command="{Binding OnboardingBackCommand}"
                    Visibility="{Binding IsOnboardingFirstStep, Converter={StaticResource InvertedBoolToVisibility}}" />

            <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}"
                    Content="{Binding OnboardingActionText}" Command="{Binding OnboardingNextCommand}" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
